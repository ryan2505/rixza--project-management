{
  "name": "rixza-client-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RIXZA Client Portal — one workspace, complete visibility, total alignment.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,gray \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=shared server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.ts --reset",
    "typecheck": "tsc --noEmit",
    "test:acceptance": "node --disable-warning=ExperimentalWarning scripts/acceptance.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.2.5",
    "@tanstack/react-query": "^5.80.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
